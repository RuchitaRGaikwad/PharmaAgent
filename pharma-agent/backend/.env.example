# Environment Variables for PharmaAgent

# Database Configuration
DATABASE_URL=sqlite:///./pharma_agent.db

# Langfuse Observability (Optional)
# Get your keys from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenAI API Key (Optional - for enhanced NLU)
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
